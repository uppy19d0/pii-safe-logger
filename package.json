{
  "name": "pii-safe-logger",
  "version": "1.3.0",
  "description": "PII-safe structured logger and redaction utilities for JavaScript and TypeScript.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "DEPLOY.md",
    "SEMVER.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "benchmark",
    "SECURITY_MODEL.md",
    "STANDARDS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "benchmark": "node benchmark/redaction-benchmark.js",
    "test:security": "node --test test/security-corpus.test.js",
    "validate": "npm test && npm run benchmark && npm_config_cache=.npm-cache npm pack --dry-run"
  },
  "keywords": [
    "logger",
    "pii",
    "pii-safe",
    "redaction",
    "privacy",
    "logging",
    "security",
    "safe-logging",
    "javascript",
    "typescript"
  ],
  "author": {
    "name": "Luis Aneuris Tavarez De Jesus",
    "url": "https://www.ltavarez.me/"
  },
  "homepage": "https://www.ltavarez.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppy19d0/pii-safe-logger.git"
  },
  "bugs": {
    "url": "https://github.com/uppy19d0/pii-safe-logger/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
